# =============================================================================
# Mist User-ID Configuration
# =============================================================================
# This file configures the mist-userid service that syncs Juniper Mist
# wireless user/IP mappings to Palo Alto firewalls via the User-ID API.
#
# Copy to /etc/mist-userid/env and fill in values.
# After changes: sudo systemctl restart mist-userid-worker mist-userid-api
# =============================================================================

# -----------------------------------------------------------------------------
# PALO ALTO FIREWALL TARGETS (Required)
# -----------------------------------------------------------------------------
# Comma-separated list of PA firewall or Panorama URLs.
# All targets receive the same User-ID updates (for HA pairs or multi-site).
# Example: https://pa-fw1.example.com,https://pa-fw2.example.com
PA_TARGETS=https://pa-fw1.example.com

# -----------------------------------------------------------------------------
# PALO ALTO AUTHENTICATION (Required - choose one option)
# -----------------------------------------------------------------------------
# Option 1: Admin credentials (recommended)
#   The service auto-generates an API key at startup and refreshes on 401.
#   Create a service account on PA with XML API permissions.
# PA_USERNAME=svc-mist-userid
# PA_PASSWORD=your-service-account-password

# Option 2: Static API key
#   Generate at Device > API Keys on the PA firewall.
#   If set, this takes precedence over username/password.
# PA_API_KEY=LUFRPT14MW5xOEo1R09...

# BREAK-GLASS ONLY: skip PA TLS certificate verification.
# Use temporarily if an expired PA cert is blocking User-ID delivery
# (see docs/runbook.md "PA SSL Certificate Expired"). The worker logs a
# WARNING at startup while this is false. RE-ENABLE AFTER CERT RENEWAL —
# the API key travels over the connection this protects.
# PA_VERIFY_SSL=true

# -----------------------------------------------------------------------------
# MIST WEBHOOK SECRET (Required)
# -----------------------------------------------------------------------------
# Shared secret for HMAC-SHA256 signature validation.
# Must match the secret configured in Mist portal under Webhooks.
# Generate with: openssl rand -base64 32
MIST_WEBHOOK_SECRET=your-webhook-secret-here

# -----------------------------------------------------------------------------
# REDIS CONNECTION (Optional)
# -----------------------------------------------------------------------------
# Redis is used for the event queue and deduplication cache.
# Default: redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# LOGGING (Optional)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
# Use INFO for production, DEBUG for troubleshooting (very verbose).
# LOG_LEVEL=INFO

# Log format: text or json
# Use json for log aggregation (Splunk, ELK, etc.)
# LOG_FORMAT=text

# -----------------------------------------------------------------------------
# USER-ID BEHAVIOR (Optional)
# -----------------------------------------------------------------------------
# Timeout in minutes for User-ID mappings on the PA firewall.
# After this time, the mapping expires unless refreshed by a roam event.
#
# IMPORTANT: Set this to match or be slightly less than your DHCP lease time.
# This prevents stale mappings if an IP gets reassigned to a different user.
#
# Examples:
#   DHCP lease 1 hour   → USERID_TIMEOUT=60
#   DHCP lease 4 hours  → USERID_TIMEOUT=240
#   DHCP lease 8 hours  → USERID_TIMEOUT=480
#   DHCP lease 24 hours → USERID_TIMEOUT=1440
#
# If you have mixed lease times (e.g. students=16hr, faculty=2hr), use the
# shortest lease as the upper bound to prevent stale mappings. Faculty/staff
# on wired are covered by AD User-ID regardless.
#
# Default: 60 (1 hour)
# USERID_TIMEOUT=360

# Comma-separated SSIDs to ignore (case-insensitive).
# Events from these SSIDs won't create User-ID mappings.
# Useful for guest networks where usernames aren't meaningful.
# IGNORE_SSIDS=Guest_WiFi,Visitor_Network

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING (Optional - defaults are usually fine)
# -----------------------------------------------------------------------------
# Max events per PA API batch. Default: 50
# BATCH_SIZE=50

# Seconds between batch flushes. Default: 2
# BATCH_FLUSH_INTERVAL=2

# Deduplication cache TTL in seconds. Default: 300 (5 min)
# Same user+IP won't be sent again within this window.
# DEDUP_TTL=300

# Max retry attempts for failed PA API calls. Default: 5
# Uses exponential backoff: 1s, 2s, 4s, 8s, 16s
# MAX_RETRY_ATTEMPTS=5

# -----------------------------------------------------------------------------
# SECURITY (Optional - defaults are usually fine)
# -----------------------------------------------------------------------------
# Max Redis queue depth before rejecting webhooks with 429.
# Prevents unbounded queue growth under sustained load or PA outages.
# Default: 10000
# MAX_QUEUE_DEPTH=10000

# Max age (seconds) for webhook events. Events with timestamps older
# than this are rejected to prevent replay attacks.
# Default: 300 (5 min)
# WEBHOOK_MAX_AGE=300
