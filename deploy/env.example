# Mist User-ID Service Configuration
# Copy to /etc/mist-userid/env and fill in values

# --- Required ---

# Comma-separated list of Palo Alto firewall/Panorama URLs
# Dev/test: individual firewalls. Prod: Panorama.
PA_TARGETS=https://panorama.example.com

# API key for Palo Alto XML API (generate in Device > Admin > API Keys)
PA_API_KEY=your-api-key-here

# Shared secret configured in the Mist webhook (used for HMAC-SHA256 validation)
MIST_WEBHOOK_SECRET=your-webhook-secret-here

# --- Optional (defaults shown) ---

# Redis connection string
REDIS_URL=redis://localhost:6379

# Max items per PA API batch
BATCH_SIZE=50

# Seconds between batch flushes
BATCH_FLUSH_INTERVAL=2

# Deduplication cache TTL in seconds
DEDUP_TTL=300

# PA API retry limit (exponential backoff: 1s, 2s, 4s, 8s, 16s)
MAX_RETRY_ATTEMPTS=5

# PA User-ID timeout in minutes
USERID_TIMEOUT=60

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
